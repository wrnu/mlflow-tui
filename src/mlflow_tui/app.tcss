Screen {
    background: #0b1116;
    layout: vertical;
}

Header {
    background: #102230;
    text-style: bold;
}

Footer {
    background: #102230;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 34;
    min-width: 24;
    background: #0e1620;
    border-right: tall #1c2c3a;
}

#experiments {
    height: 1fr;
    border: none;
    padding: 0 1;
}

#experiments > .option-list--option-highlighted {
    background: #123447;
    color: #7ee0ff;
    text-style: bold;
}

#filter {
    margin: 0 1 1 1;
    background: #102230;
    border: none;
}

#main {
    width: 1fr;
}

#runs {
    height: 1fr;
}

#detail {
    height: 1fr;
    min-height: 14;
    border-top: tall #1c2c3a;
}

#plot-pane {
    width: 3fr;
    border-right: tall #1c2c3a;
}

#kv-tabs {
    width: 2fr;
}

#run-meta {
    padding: 0 1;
    height: auto;
    color: #c5d4de;
}

.pane-title {
    text-style: bold;
    color: #7ee0ff;
    padding: 0 1;
    background: #102230;
    height: 1;
}

DataTable {
    height: 1fr;
}

Tree {
    padding: 0 1;
}

TabbedContent {
    height: 1fr;
}
