Screen {
    background: #0b1116;
    layout: vertical;
}

Header {
    background: #102230;
    text-style: bold;
}

Footer {
    background: #102230;
    height: auto;
    min-height: 1;
}

#body {
    height: 1fr;
}

#sidebar {
    width: 18;
    min-width: 14;
    max-width: 22;
    background: #0e1620;
    border-right: tall #1c2c3a;
}

Screen.sidebar-hidden #sidebar {
    display: none;
}

#experiments {
    height: 1fr;
    border: none;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#experiments > .option-list--option-highlighted {
    background: #123447;
    color: #7ee0ff;
    text-style: bold;
}

#experiments > .option-list--option-hover {
    background: #102230;
}

#filter {
    margin: 0 1 1 1;
    background: #102230;
    border: none;
    pointer: text;
    width: 1fr;
    min-width: 0;
    text-overflow: ellipsis;
}

#experiments,
#runs,
#params,
#tags,
#artifacts,
#kv-tabs,
#experiments-title,
#runs-title,
#run-meta {
    pointer: pointer;
}

#main {
    width: 1fr;
    height: 1fr;
}

#runs {
    height: 1fr;
    min-height: 8;
}

#detail {
    height: 1fr;
    min-height: 8;
    border-top: tall #1c2c3a;
}

#plot-pane {
    width: 3fr;
    border-right: tall #1c2c3a;
}

#kv-tabs {
    width: 2fr;
}

#run-meta {
    padding: 0 1;
    height: auto;
    color: #c5d4de;
}

.pane-title {
    text-style: bold;
    color: #7ee0ff;
    padding: 0 1;
    background: #102230;
    height: 1;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

DataTable {
    height: 1fr;
}

Tree {
    padding: 0 1;
}

TabbedContent {
    height: 1fr;
}

Screen.graph-focus Header,
Screen.graph-focus #sidebar,
Screen.graph-focus #runs-title,
Screen.graph-focus #runs,
Screen.graph-focus #kv-tabs {
    display: none;
}

Screen.graph-focus #detail {
    height: 1fr;
    min-height: 0;
    border-top: none;
}

Screen.graph-focus #plot-pane {
    width: 1fr;
    border-right: none;
}

#plot {
    background: #080d12;
}
